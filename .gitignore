# ── 虚拟环境 ──
.venv/
venv/
env/

# ── Python 缓存 / 构建产物 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ── 本地数据（审计库里有真实调用记录，不入库）──
data/*.db
data/*.db-journal
data/*.sqlite3
data/*.log

# ── 实验脚本产生的临时文件（配置备份、运行日志）──
*.log
config/*.bak
config/*.labbak

# ── 本地对比用的原版备份（.orig）不公开 ──
*.orig

# ── 密钥与环境变量（providers.yaml 只存 ${ENV} 占位，真实值走环境变量）──
.env
.env.*
config/providers.local.yaml

# ── 编辑器 / 系统 ──
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── 个人备考材料，不随仓库公开 ──
# 想公开学习笔记就把下面三行删掉
docs/INTERVIEW_GUIDE.md
docs/STUDY_PLAN.md
docs/NOTES_DAY1.md
